{
  "name": "kenjitsu-extensions",
  "version": "0.0.0-development",
  "description": "A lightweight Node.js scraper that extracts video sources from streaming sites",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "module": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "pnpm build && node dist/main.js",
    "test": "vitest  --config vitest.config.ts",
    "lint": "tsc",
    "ci": "tsc && pnpm test && pnpm run build",
    "format": "prettier --write .",
    "semantic-release": "semantic-release --branches main"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "anime",
    "scraper",
    "movies",
    "tv"
  ],
  "author": "middlegear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/middlegear/kenjitsu-extensions"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/middlegear/kenjitsu-extensions",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.3",
    "@types/parse-torrent": "^11.0.1",
    "@types/torrent-stream": "^0.0.9",
    "prettier": "^3.9.6",
    "semantic-release": "^24.2.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "anitomy-ng": "^1.0.9",
    "cheerio": "^1.2.0",
    "fuzzball": "^2.2.6",
    "impit": "^0.14.3",
    "p-queue": "^9.3.3",
    "parse-torrent": "^11.0.24",
    "torrent-stream": "^1.2.1",
    "tough-cookie": "^6.0.2"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
